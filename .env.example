# Settings for compose.yaml. Copy to .env and fill in. .env is gitignored.

# Required. SHA-256 hash of the API key shared by all clients; never the key itself.
# Generate a key and its hash with: ./keygen.sh
MIOLINK_API_KEY_HASH=

# Origins allowed to call the API from a browser: the public URL of the web
# client, as served by the reverse proxy (comma-separated).
MIOLINK_CORS_ORIGINS=https://miolink.example.com

# Host address the ports 3000 (web) and 3001 (API) are published on.
# 127.0.0.1 when the reverse proxy runs on the same host; 0.0.0.0 to reach
# them from the LAN.
MIOLINK_BIND_ADDR=127.0.0.1
