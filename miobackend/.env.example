# Copy to .env and fill in. .env is gitignored.

# Required. SHA-256 hash of the API key shared by all clients; never the key itself.
# Generate a key and its hash with: make keygen
MIOLINK_API_KEY_HASH=

# Optional (defaults shown).
MIOLINK_ADDR=:8080
MIOLINK_DATABASE_PATH=miolink.db
# Directory for stored thumbnails; created on startup if missing (a Docker volume in production).
MIOLINK_THUMBNAILS_DIR=thumbnails

# Optional. Comma-separated origins allowed to call the API from a browser.
MIOLINK_CORS_ORIGINS=http://localhost:5173
