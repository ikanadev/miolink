<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. The API key's ciphertext and its Tink keyset
     are excluded: the keyset is wrapped by an Android Keystore key that never
     leaves the device, so a restored copy couldn't be decrypted. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/server_settings.preferences_pb" />
        <exclude domain="sharedpref" path="miolink_api_key_keyset.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/server_settings.preferences_pb" />
        <exclude domain="sharedpref" path="miolink_api_key_keyset.xml" />
    </device-transfer>
</data-extraction-rules>
